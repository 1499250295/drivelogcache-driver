<?xml version="1.0" encoding="utf-8"?>
<!--
  DriveLogCache minifilter 驱动工程
  构建要求: Visual Studio 2022 + Windows Driver Kit (WDK) 10
  构建命令: msbuild drivelogcache.vcxproj /p:Configuration=Release /p:Platform=x64
